POSTGRES_USER=pipre_user
POSTGRES_PASSWORD=pipre_password
POSTGRES_DB=pipre_database
DATABASE_URL=jdbc:postgresql://postgres:5432/pipre_database
PORT_BACK=8080
PORT_FRONT=5173
VITE_USE_LOCAL_BACKEND=true
VITE_LOCAL_BACKEND_URL=http://localhost:8080
## Cookie y CORS del backend (orígenes exactos separados por comas, sin / final)
PIPRE_COOKIE_SECURE=false
PIPRE_COOKIE_SAME_SITE=Lax
PIPRE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
